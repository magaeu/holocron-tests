name: 'Playwright Report'
description: 'Upload suite reports and Playwright blob reports'

inputs:
  test-type:
    description: 'Test suite that generated the report'
    required: true

runs:
  using: composite
  steps:
    - name: Upload suite report and results
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: playwright-report-${{ inputs.test-type }}-${{ github.run_id }}-${{ github.run_attempt }}
        path: |
          playwright-report/
          test-results/
        if-no-files-found: warn
        retention-days: 5

    - name: Upload blob report for merging
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: blob-report-${{ inputs.test-type }}-${{ github.run_id }}-${{ github.run_attempt }}
        path: blob-report/
        if-no-files-found: warn
        retention-days: 5