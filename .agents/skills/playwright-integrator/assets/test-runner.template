name: Test Runner

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:
    inputs:
      suite:
        description: Test suite to run
        required: true
        type: choice
        options:
          - smoke
          - sanity
          - regression
        default: smoke

jobs:
  test:
    name: Playwright ${{ github.event_name == 'workflow_dispatch' && inputs.suite || 'smoke' }} tests
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Playwright
        uses: ./.github/actions/setup-ci

      - name: Run smoke tests
        if: ${{ github.event_name != 'workflow_dispatch' || inputs.suite == 'smoke' }}
        uses: ./.github/actions/smoke-tests

      - name: Run sanity tests
        if: ${{ github.event_name == 'workflow_dispatch' && inputs.suite == 'sanity' }}
        uses: ./.github/actions/sanity-tests

      - name: Run regression tests
        if: ${{ github.event_name == 'workflow_dispatch' && inputs.suite == 'regression' }}
        uses: ./.github/actions/regression-tests

  merge-report:
    name: Merge Playwright reports
    if: always()
    needs: [test]
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up CI
        uses: ./.github/actions/setup-ci

      - name: Download blob reports
        uses: actions/download-artifact@v4
        with:
          path: all-blob-reports
          pattern: blob-report-*
          merge-multiple: true

      - name: Merge reports
        run: npx playwright merge-reports --reporter html ./all-blob-reports

      - name: Upload merged HTML report
        uses: actions/upload-artifact@v4
        with:
          name: merged-playwright-report-${{ github.run_id }}-${{ github.run_attempt }}
          path: playwright-report/
          if-no-files-found: warn
          retention-days: 5
