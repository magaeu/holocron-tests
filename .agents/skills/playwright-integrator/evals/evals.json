        ".github/workflows/test-runner.yml file is created",
        "github/actions/setup-ci/actions.yml file is created",
        "github/actions/smoke-tests/actions.yml file is created",
        "github/actions/sanity-tests/actions.yml file is created",
        "github/actions/regression-tests/actions.yml file is created",
        "github/actions/report/actions.yml is created"
