      "expected_output": ".github/workflows and .github/actions folders are created",
      "assertions": [
        ".github/workflows folder is created and empty",
        "github/actions/setup-ci folder is created and empty",
        "github/actions/smoke-tests folder is created and empty",
        "github/actions/sanity-tests folder is created and empty",
        "github/actions/regression-tests folder is created and empty",
        "github/actions/report folder is created and empty"
      ]
    },
    {
      "id": "create-pipeline-files-request",
      "prompt": "create pipeline files",
      "expected_output": "workflows and actions files are created",
